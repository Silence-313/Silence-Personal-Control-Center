# Silence Control Center — Backend configuration
# Copy to `.env` and fill in values. `.env` is git-ignored.

CONTROL_CENTER_ENV=development
CONTROL_CENTER_HOST=127.0.0.1
CONTROL_CENTER_PORT=8000

# Bearer token required for protected endpoints (commands, etc.).
# Leave empty in local development; the backend then permits localhost only.
CONTROL_CENTER_API_TOKEN=

# SQLite database location. A file path inside backend/data/ is used by default.
CONTROL_CENTER_DATABASE_URL=sqlite:///./data/control-center.db

# Comma-separated list of allowed CORS origins (the Next.js frontend).
CONTROL_CENTER_ALLOWED_ORIGINS=http://localhost:3000

# Local node identity (v0.1 registers one machine).
CONTROL_CENTER_NODE_ID=macbook-pro
CONTROL_CENTER_NODE_NAME=MacBook Pro
CONTROL_CENTER_HEARTBEAT_INTERVAL_SECONDS=10

# Path to the project registry (read-only git monitoring).
# Defaults to backend/config/projects.yaml — leave unset unless you need another location.
# CONTROL_CENTER_PROJECTS_CONFIG=/path/to/projects.yaml